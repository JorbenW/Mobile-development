rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Profile of a user: only the owner reads and writes it,
    // so nobody can list the names and e-mails of other users.
    // The role is chosen once at registration and can never change.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.role in ['customer', 'merchant'];
      allow update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.role == resource.data.role;
    }

    // Store of a merchant, at stores/{uid} (ADR 0004).
    // Write rules come with Mijn winkel (H1).
    match /stores/{uid} {
      allow read: if request.auth != null;
    }
  }
}
